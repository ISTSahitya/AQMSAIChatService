<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS hosting configuration for HAWAQM AI Chat Service.
  Requires .NET 8 Hosting Bundle installed on the Windows Server.
  This file should be deployed alongside the published application.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <!-- ASP.NET Core module — uses out-of-process (reverse proxy) hosting -->
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet"
                  arguments=".\HawaqmAI.Api.dll"
                  stdoutLogEnabled="true"
                  stdoutLogFile=".\logs\stdout"
                  hostingModel="outofprocess">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
          <!--
            Set sensitive values as environment variables on the server
            rather than in this file. Example:
            <environmentVariable name="Database__AirQualityConnection" value="..." />
            <environmentVariable name="Database__ChatHistoryConnection" value="..." />
            <environmentVariable name="AzureAI__ApiKey" value="..." />
            <environmentVariable name="Jwt__Secret" value="..." />
          -->
        </environmentVariables>
      </aspNetCore>

      <!-- Security headers -->
      <httpProtocol>
        <customHeaders>
          <add name="X-Content-Type-Options" value="nosniff" />
          <add name="X-Frame-Options" value="DENY" />
          <add name="X-XSS-Protection" value="1; mode=block" />
          <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        </customHeaders>
      </httpProtocol>

      <!-- Increase request timeout for long AI responses -->
      <security>
        <requestFiltering>
          <requestLimits maxAllowedContentLength="10485760" /> <!-- 10 MB -->
        </requestFiltering>
      </security>
    </system.webServer>
  </location>
</configuration>
